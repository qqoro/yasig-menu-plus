{
  "name": "yasig-menu-plus",
  "displayName": "야식메뉴판 Plus",
  "version": "1.21.2",
  "description": "야식 관리에 도움이 되는 가벼운 앱",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qqoro/yasig-menu-plus.git"
  },
  "main": "main/main.js",
  "author": {
    "name": "qqoro"
  },
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "build": "tsc --noEmit && node scripts/build.js && electron-builder --win --publish=never",
    "build:port": "tsc --noEmit && node scripts/build.js && electron-builder --win portable --publish=never",
    "build:win": "tsc --noEmit && node scripts/build.js && electron-builder --win --publish=never",
    "build:port:win": "tsc --noEmit && node scripts/build.js && electron-builder --win portable --publish=never",
    "prepare": "husky",
    "postinstall": "node scripts/license.js",
    "lint": "oxlint",
    "format": "prettier src/ --write",
    "type-check": "tsc --noEmit -p src/main/tsconfig.json && tsc --noEmit -p src/main/tsconfig.test.json && vue-tsc -p src/renderer/tsconfig.json --noEmit",
    "lint-staged": "lint-staged",
    "test": "vitest run",
    "test:watch": "vitest",
    "changelog": "git-cliff -o CHANGELOG.md",
    "changelog:latest": "git-cliff -l -o RELEASE_NOTES.md"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "prettier --write",
      "oxlint"
    ]
  },
  "type": "module",
  "devDependencies": {
    "@iconify-json/material-symbols": "^1.2.91",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/solar": "^1.2.10",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@iconify/vue": "^5.0.1",
    "@internationalized/date": "^3.12.4",
    "@kfonts/d2coding": "^0.2.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-query": "^5.102.8",
    "@types/archiver": "^8.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.5.0",
    "@types/semver": "^7.8.0",
    "@types/steam-user": "^5.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vueuse/core": "^14.4.0",
    "chalk": "^6.0.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.15",
    "echarts": "^6.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "lucide-vue-next": "^0.563.0",
    "marked": "^18.0.12",
    "oxlint": "^1.82.0",
    "pinia": "^4.0.3",
    "pretendard": "^1.3.9",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "reka-ui": "^2.10.4",
    "semver": "^7.8.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue": "^3.5.42",
    "vue-echarts": "^8.3.0",
    "vue-router": "5",
    "vue-sonner": "^2.0.9",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@img/sharp-win32-x64": "^0.35.4",
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "chrome-launcher": "^1.2.1",
    "dayjs": "^1.11.23",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3",
    "iconv-lite": "^0.7.3",
    "knex": "^3.3.0",
    "node-html-parser": "^9.0.4",
    "puppeteer-core": "^25.10.0",
    "sharp": "^0.35.4",
    "steam-user": "^5.3.0"
  },
  "packageManager": "pnpm@12.3.4"
}
